{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "skillget",
  "version": "0.4.0",
  "identifier": "com.yourbossdonpely.skillget",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://127.0.0.1:5179",
    "beforeBuildCommand": "",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/node.exe",
      "resources/server",
      "resources/frontend"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    }
  }
}
