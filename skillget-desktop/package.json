{
  "name": "skillget-desktop",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Desktop browser/installer for TypingMind skills into ~/.agents/skills",
  "scripts": {
    "dev": "node server/index.mjs",
    "build": "vite build",
    "start": "node server/index.mjs --prod",
    "app:sidecar": "node scripts/prepare-sidecar.mjs",
    "app:build": "vite build && node scripts/prepare-sidecar.mjs && tauri build",
    "app:portable": "node scripts/make-portable.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.0.0"
  }
}
